ents" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="538" width="260" height="56" as="geometry"/></mxCell><mxCell id="c42" value="MERGED: no rebalance, no break" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="538" width="330" height="56" as="geometry"/></mxCell><mxCell id="c43" value="Several changes on same date D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="594" width="200" height="56" as="geometry"/></mxCell><mxCell id="c44" value="Several close / insert at D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="594" width="330" height="56" as="geometry"/></mxCell><mxCell id="c45" value="One breakpoint" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="594" width="260" height="56" as="geometry"/></mxCell><mxCell id="c46" value="One segment, not several" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="594" width="330" height="56" as="geometry"/></mxCell><mxCell id="c47" value="Retroactive correction of history" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="200" height="56" as="geometry"/></mxCell><mxCell id="c48" value="UPDATE past rows (exception)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="650" width="330" height="56" as="geometry"/></mxCell><mxCell id="c49" value="Past segments change" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="650" width="260" height="56" as="geometry"/></mxCell><mxCell id="c50" value="Recompute from earliest changed date, invalidate cache" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="650" width="330" height="56" as="geometry"/></mxCell><mxCell id="c51" value="Mapping ends, no replacement" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="200" height="56" as="geometry"/></mxCell><mxCell id="c52" value="end_date set, nothing inserted" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="706" width="330" height="56" as="geometry"/></mxCell><mxCell id="c53" value="Gap after end_date" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="706" width="260" height="56" as="geometry"/></mxCell><mxCell id="c54" value="GapPolicy: RAISE (default) or FLAT (return 0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="706" width="330" height="56" as="geometry"/></mxCell><mxCell id="c55" value="Overlap same (parent, child, type)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="200" height="56" as="geometry"/></mxCell><mxCell id="c56" value="Two rows active together" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="762" width="330" height="56" as="geometry"/></mxCell><mxCell id="c57" value="Invalid" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="762" width="260" height="56" as="geometry"/></mxCell><mxCell id="c58" value="Rejected at validation" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="762" width="330" height="56" as="geometry"/></mxCell><mxCell id="c59" value="SUM(weights) != 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="200" height="56" as="geometry"/></mxCell><mxCell id="c60" value="Bad insert" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="818" width="330" height="56" as="geometry"/></mxCell><mxCell id="c61" value="Invalid vector" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="818" width="260" height="56" as="geometry"/></mxCell><mxCell id="c62" value="RAISE (default) or normalize" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="818" width="330" height="56" as="geometry"/></mxCell><mxCell id="c63" value="Change on a non-trading day" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="874" width="200" height="56" as="geometry"/></mxCell><mxCell id="c64" value="start_date = Saturday" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="874" width="330" height="56" as="geometry"/></mxCell><mxCell id="c65" value="Segment starts on that date" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="874" width="260" height="56" as="geometry"/></mxCell><mxCell id="c66" value="Applies from first trading day &gt;= D (ffill prices)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="874" width="330" height="56" as="geometry"/></mxCell><mxCell id="c67" value="end_date NULL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="200" height="56" as="geometry"/></mxCell><mxCell id="c68" value="Row still active" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="930" width="330" height="56" as="geometry"/></mxCell><mxCell id="c69" value="Last segment ends at as_of = today" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="930" width="260" height="56" as="geometry"/></mxCell><mxCell id="c70" value="Open segment extended to today" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="930" width="330" height="56" as="geometry"/></mxCell><mxCell id="c71" value="Grey/white = normal lifecycle changes. Yellow = no-op or merge. Red = exceptions and data quality." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="1100" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 - Computation logic" id="4 x"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Computation logic (per parent and per type)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="900" height="35" as="geometry"/></mxCell><mxCell id="c3" value="INPUT: parent P, type T, initial amount, as_of = today, rebalancing mode" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="380" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Load mapping rows WHERE FkIdInstrumentParent = P AND type = T" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="168" width="380" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Validate: start &lt;= end, 0 &lt; weight &lt;= 1, no overlap per (parent, child, type)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="258" width="380" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Breakpoints = all start_date and all (end_date + 1), clipped to [min start, as_of]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="348" width="380" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Build segments: active rows = start &lt;= s AND (end IS NULL OR end &gt;= e)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="438" width="380" height="56" as="geometry"/></mxCell><mxCell id="c8" value="SUM(weights) = 1 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="528" width="380" height="84" as="geometry"/></mxCell><mxCell id="c9" value="Active rows exist ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="646" width="380" height="84" as="geometry"/></mxCell><mxCell id="c10" value="Merge consecutive segments with identical weight vectors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="764" width="380" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Load prices of child benchmarks, forward-fill, check no NaN on used legs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="854" width="380" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Rebalancing mode ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="944" width="380" height="84" as="geometry"/></mxCell><mxCell id="c13" value="DAILY&lt;br&gt;growth = cumprod(1 + SUM(w_i * r_i,t))" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="1062" width="330" height="60" as="geometry"/></mxCell><mxCell id="c14" value="AT_CHANGE (drift)&lt;br&gt;growth = SUM(w_i * P_i,t / P_i,prev close)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="1062" width="360" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Chain segments: V_t = V_prev close * growth   (V_0 = initial amount)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="1156" width="380" height="56" as="geometry"/></mxCell><mxCell id="c16" value="OUTPUT: rebased value, daily_return, cumulative_return = V_t / V_0 - 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="1246" width="380" height="56" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="DAILY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="AT_CHANGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="Reject / raise error&lt;br&gt;(overlap, bad dates, bad weight)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="260" height="56" as="geometry"/></mxCell><mxCell id="c32" value="RAISE (default)&lt;br&gt;or normalize weights" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="534" width="260" height="56" as="geometry"/></mxCell><mxCell id="c33" value="Gap: RAISE (default)&lt;br&gt;or FLAT (return 0, value carried)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="638" width="260" height="56" as="geometry"/></mxCell><mxCell id="c34" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="c5" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="c8" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="c9" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="Repeat for each parent and each type cciBenchmark1..5 (independent series).&lt;br&gt;SINGLE benchmark = composite with one leg of weight 1.0." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
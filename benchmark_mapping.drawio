Geometry x="40" y="146" width="200" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Close A&lt;br&gt;INSERT B (start=D)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="146" width="330" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Segment from D with B instead of A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="146" width="260" height="56" as="geometry"/></mxCell><mxCell id="c14" value="Leg swap, weights unchanged" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="146" width="330" height="56" as="geometry"/></mxCell><mxCell id="c15" value="Partial mapping change (B -&gt; C, A kept)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="200" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Close B&lt;br&gt;INSERT C&lt;br&gt;A row left open if its weight is unchanged" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="202" width="330" height="56" as="geometry"/></mxCell><mxCell id="c17" value="Vector A|B becomes A|C at D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="202" width="260" height="56" as="geometry"/></mxCell><mxCell id="c18" value="Only legs that differ are touched; SUM = 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="202" width="330" height="56" as="geometry"/></mxCell><mxCell id="c19" value="Leg added" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="258" width="200" height="56" as="geometry"/></mxCell><mxCell id="c20" value="Close changed legs&lt;br&gt;INSERT new leg + resized others" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="258" width="330" height="56" as="geometry"/></mxCell><mxCell id="c21" value="More legs from D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="258" width="260" height="56" as="geometry"/></mxCell><mxCell id="c22" value="Weights rescaled by data, validated SUM = 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="258" width="330" height="56" as="geometry"/></mxCell><mxCell id="c23" value="Leg removed" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="200" height="56" as="geometry"/></mxCell><mxCell id="c24" value="Close leg&lt;br&gt;INSERT resized remaining legs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="314" width="330" height="56" as="geometry"/></mxCell><mxCell id="c25" value="Fewer legs from D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="314" width="260" height="56" as="geometry"/></mxCell><mxCell id="c26" value="Validated SUM = 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="314" width="330" height="56" as="geometry"/></mxCell><mxCell id="c27" value="Composite -&gt; single" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="200" height="56" as="geometry"/></mxCell><mxCell id="c28" value="Close all legs&lt;br&gt;INSERT 1 leg weight 1.0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="370" width="330" height="56" as="geometry"/></mxCell><mxCell id="c29" value="Single segment from D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="570" y="370" width="260" height="56" as="geometry"/></mxCell><mxCell id="c30" value="Single = composite with one leg" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="370" width="330" height="56" as="geometry"/></mxCell><mxCell id="c31" value="Single -&gt; composite" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="426" width="200" height="56" as="geometry"/></mxCell><mxCell id="c32" value="Close leg&lt;br&gt;INSERT N legs, SUM = 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="426" width="330" height="56" as="geometry"/></mxCell><mxCell id="c33" value="Composite segment from D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaaaaa;align=left;spacingLeft=6;" vertex="1" parent
cingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c7"><mxGeometry x="0" y="186" width="400" height="26" as="geometry"/></mxCell><mxCell id="c15" value="parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;" edge="1" parent="1" source="c9" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="child (benchmark)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="type  (5 possible)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="230" height="160" as="geometry"/></mxCell><mxCell id="c18" value="cciBenchmark1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="230" height="26" as="geometry"/></mxCell><mxCell id="c19" value="cciBenchmark2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="56" width="230" height="26" as="geometry"/></mxCell><mxCell id="c20" value="cciBenchmark3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="82" width="230" height="26" as="geometry"/></mxCell><mxCell id="c21" value="cciBenchmark4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="108" width="230" height="26" as="geometry"/></mxCell><mxCell id="c22" value="cciBenchmark5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="134" width="230" height="26" as="geometry"/></mxCell><mxCell id="c23" value="A SERIES = (FkIdInstrumentParent, type).&lt;br&gt;Each of the 5 types is an independent&lt;br&gt;series, single or composite." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="300" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Rules&lt;br&gt;1. Series is SINGLE if exactly 1 child is active (weight = 1), COMPOSITE if more than 1.&lt;br&gt;2. Dates are inclusive. end_date NULL = active until today (as_of).&lt;br&gt;3. On every date, SUM(weight) of active rows per (parent, type) = 1.&lt;br&gt;4. No overlap of two rows with the same (parent, child, type).&lt;br&gt;5. A change NEVER rewrites history: close old rows (end_date = D-1) and INSERT new rows (start_date = D).&lt;br&gt;6. Weights active on day d drive the return of day d (set at the previous close).&lt;br&gt;7. Retroactive correction of past rows = recompute the series from the earliest changed date." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1000" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Sample data and timeline" id="2 x"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Sample rows and lifecycle of the mapping" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="900" height="35" as="geometry"/></mxCell><mxCell id="c3" value="breakdownId" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="90" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Parent" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="60" width="70" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Child" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="70" height="30" as="geometry"/></mxCell><mxCell id="c6" value="weight" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="70" height="30" as="geometry"/></mxCell><mxCell id="c7" value="start_date" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="100" height="30" as="geometry"/></mxCell><mxCell id="c8" value="end_date" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="100" height="30" as="geometry"/></mxCell><mxCell id="c9" value="type" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="110" height="30" as="geometry"/></mxCell><mxCell id="c10" value="What happened" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#333333;fo